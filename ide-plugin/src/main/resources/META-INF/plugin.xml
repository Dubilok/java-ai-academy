<idea-plugin>
    <id>com.javaacademy.plugin</id>
    <name>Java AI Academy</name>
    <vendor>Java AI Academy</vendor>

    <description><![CDATA[
        Learn Java 21+ directly from IntelliJ IDEA.
        Browse courses, start tasks, submit code for instant JUnit verification,
        and get Socratic AI hints — without leaving your IDE.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="Java AI Academy"
            anchor="right"
            secondary="false"
            icon="/icons/toolwindow.svg"
            factoryClass="com.javaacademy.plugin.toolwindow.AcademyToolWindowFactory"/>
        <notificationGroup
            id="Java AI Academy"
            displayType="BALLOON"
            isLogByDefault="true"/>
    </extensions>

</idea-plugin>
