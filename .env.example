# ---------- copy to .env and fill in; .env is git-ignored ----------

# Database
POSTGRES_DB=javaacademy
POSTGRES_USER=academy
POSTGRES_PASSWORD=change_me_locally
DB_URL=jdbc:postgresql://localhost:5432/javaacademy

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security  (min 256-bit secret; generate: openssl rand -base64 48)
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# AI providers
LLM_PROVIDER=anthropic           # anthropic | bedrock — switches the primary LlmClient
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Cloud track (Epic E9)
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250514-v1:0
AWS_BEDROCK_GUARDRAIL_ID=               # leave empty to disable guardrails
AWS_BEDROCK_GUARDRAIL_VERSION=          # e.g. "1" or "DRAFT"
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY resolved by the default AWS credential chain
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=

# Sandbox
SANDBOX_IMAGE=java-ai-academy/runner:21
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_CONCURRENT=8
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5

# AI spend guardrails
AI_MAX_USD_PER_USER_PER_DAY=1.00
AI_MAX_USD_GLOBAL_PER_DAY=50.00
