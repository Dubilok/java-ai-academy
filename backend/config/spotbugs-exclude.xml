<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>

    <!--
      JPA entities hold references to other entities by design — that is how the ORM
      relationship graph works. EI_EXPOSE_REP / EI_EXPOSE_REP2 would require defensive
      copies of every entity reference, which breaks lazy loading and is not a real
      security concern inside a server-side ORM layer.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Package name="~com\.javaacademy\.platform\.(auth|catalog|progress|interview|ai|sandbox)(\..+)?"/>
    </Match>

    <!-- Spring @Configuration classes use inheritance patterns SpotBugs flags -->
    <Match>
        <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Match>

    <!-- Test classes: intentional null usage, magic numbers, swallowed exceptions for skip logic -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE,UWF_UNWRITTEN_FIELD,DLS_DEAD_LOCAL_STORE,DE_MIGHT_IGNORE"/>
    </Match>

    <!--
      Text blocks use \n as line separator by design — %n would produce platform-specific
      line endings, which is wrong for JSON test fixtures. SpotBugs VA_FORMAT_STRING_USES_NEWLINE
      is a false positive on .formatted() calls inside text-block string constants.
    -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!--
      AI service classes read a classpath Resource in their primary constructor (to load the system
      prompt), which throws checked IOException. The classes cannot be marked final because Spring
      CGLIB proxying requires a subclassable bean. SEI CERT OBJ-11 concern is negligible here
      because no subclasses exist and the resource path is fully controlled by the application.
    -->
    <Match>
        <Class name="com.javaacademy.platform.ai.service.ContentArchitectService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.javaacademy.platform.ai.service.SocraticMentorService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="com.javaacademy.platform.ai.service.JudgeService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

</FindBugsFilter>
